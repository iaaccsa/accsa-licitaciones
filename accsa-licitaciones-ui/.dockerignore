# Careful with broad patterns: the app reads CHANGELOG.md and content/help/*.md
# from process.cwd(), so a "*.md" breaks the build of /changelog and /ayuda.
# Same with "*.png", which would drop the images under public/.
node_modules/
.next/
.next-e2e/
.env
.env.*
.git/
.agent/
.agents/
.claude/
e2e/
playwright-report/
test-results/
docs/
tsconfig.tsbuildinfo
openapi.json
/phases.html
/phases.jsx
/debug-webhook.ts
/status_page_grouped.png
/status_page_list_view.png
