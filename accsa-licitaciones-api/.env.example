# Supabase
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_KEY

# Qdrant
QDRANT_URL=YOUR_QDRANT_URL
QDRANT_API_KEY=YOUR_QDRANT_KEY

# API Key
BACKEND_API_KEY=

# Control plane injected into service jobs at launch.
# Public URL of this API used by jobs for callbacks. REQUIRED, per-deployment
# (never localhost in prod). The API will not start without it.
SERVICE_API_BASE_URL=https://accsa-licitaciones-api.vercel.app
# Public Supabase Storage base for artifacts. Optional; empty -> derived from SUPABASE_URL.
SUPABASE_ARTIFACTS_BASE_URL=

# Job execution backend: "azure" (Container Apps Jobs) or "local" (the on-prem
# executor agent on VM2). The two blocks below are required by one path each.
JOB_EXECUTOR=azure

# Executor agent, only with JOB_EXECUTOR=local. Reachable from this API only:
# VM2 filters 8080 to VM1. The key is the agent's own, not BACKEND_API_KEY.
EXECUTOR_BASE_URL=http://10.97.0.12:8080
EXECUTOR_API_KEY=

# Azure, only with JOB_EXECUTOR=azure. Optional otherwise: the client is built
# on first use, so the API starts on-prem with all six empty.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_CONTAINER_REGISTRY=

# Paths consumed by services project
# API_ADMISSIBILITY_REQUIREMENTS_PATH=/api/v1/admissibility-requirements/
# API_ADMISSIBILITY_RESULTS_PATH=/api/v1/admissibility-results/
